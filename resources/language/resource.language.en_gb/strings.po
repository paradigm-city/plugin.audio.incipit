# Kodi Media Center language file
# Addon Name: MusicIP
# Addon id: plugin.audio.musicip
# Addon Provider: paradigm_city
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: en_GB\n"

msgctxt "#30100"
msgid "General"
msgstr ""

msgctxt "#30101"
msgid "Extended plugin logging"
msgstr ""

msgctxt "#30102"
msgid "Writes detailed messages from the add-on's menus and actions to Kodi's log (kodi.log). Useful when looking into a problem; otherwise leave it off."
msgstr ""

msgctxt "#30103"
msgid "HTTP timeout (seconds)"
msgstr ""

msgctxt "#30104"
msgid "How long to wait for the MusicIP server to answer. Raise it if large mixes or a busy server cause time-outs."
msgstr ""

msgctxt "#30200"
msgid "MusicIP server"
msgstr ""

msgctxt "#30201"
msgid "Host"
msgstr ""

msgctxt "#30202"
msgid "Name or address of the computer that runs the MusicIP server. \"localhost\" when it runs on this computer."
msgstr ""

msgctxt "#30203"
msgid "Port"
msgstr ""

msgctxt "#30204"
msgid "Port of the MusicIP server's web interface. MusicIP's default is 10002."
msgstr ""

msgctxt "#30300"
msgid "Mix parameters"
msgstr ""

msgctxt "#30301"
msgid "Mix size (tracks)"
msgstr ""

msgctxt "#30302"
msgid "How many tracks a new mix has. \"More like this\" and \"Less like this\" change a mix by a fifth of this number."
msgstr ""

msgctxt "#30303"
msgid "Style preference (0 ignore, 10 strongly prefer)"
msgstr ""

msgctxt "#30304"
msgid "How strongly MusicIP favours tracks in the seed's style. 0 ignores style; 10 strongly prefers it."
msgstr ""

msgctxt "#30305"
msgid "Variety"
msgstr ""

msgctxt "#30306"
msgid "How far MusicIP may reach from the seed. 0 keeps a mix close to the seed's sound; 9 gives the widest choice."
msgstr ""

msgctxt "#30307"
msgid "MusicIP filter"
msgstr ""

msgctxt "#30308"
msgid "Name of a filter defined in MusicIP, for example to leave out certain genres. Empty: no filter."
msgstr ""

msgctxt "#30309"
msgid "Do not repeat artist within this many tracks"
msgstr ""

msgctxt "#30310"
msgid "Keeps an artist from appearing again within this many tracks. 0 allows repeats."
msgstr ""

msgctxt "#30500"
msgid "Discovery mode"
msgstr ""

msgctxt "#30501"
msgid "Excerpt length (seconds)"
msgstr ""

msgctxt "#30502"
msgid "How many seconds of each song Discovery mode and Radio's \"Scan stations\" play."
msgstr ""

msgctxt "#30503"
msgid "Start offset into song (%)"
msgstr ""

msgctxt "#30504"
msgid "Where in each song the excerpt starts, as a share of its length. 33 % skips most intros."
msgstr ""

msgctxt "#30600"
msgid "Consistency check"
msgstr ""

msgctxt "#30601"
msgid "Enable saved-mix consistency service"
msgstr ""

msgctxt "#30602"
msgid "Regularly checks saved mixes for files that were moved or deleted, and marks the mixes affected with a red \"!\"."
msgstr ""

msgctxt "#30603"
msgid "Check interval (minutes)"
msgstr ""

msgctxt "#30604"
msgid "How often the consistency check runs."
msgstr ""

msgctxt "#30605"
msgid "Extended service logging"
msgstr ""

msgctxt "#30606"
msgid "Writes detailed messages from the background service to Kodi's log (kodi.log)."
msgstr ""

msgctxt "#30607"
msgid "Enable automatic mix repair"
msgstr ""

msgctxt "#30608"
msgid "Replaces missing files in saved mixes on its own when the library has a safe match (the same song, moved or re-tagged). Uncertain cases are left for \"Auto-repair this mix\" in the mix's context menu."
msgstr ""
