<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings version="1">
    <section id="plugin.audio.musicip">
        <category id="general" label="30100">
            <group id="1">
                <setting id="plugin_extended_logging" type="boolean" label="30101" help="30102">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle"/>
                </setting>
                <setting id="timeout" type="integer" label="30103" help="30104">
                    <level>0</level>
                    <default>10</default>
                    <control type="edit" format="integer"><heading>30103</heading></control>
                </setting>
            </group>
        </category>
        <category id="server" label="30200">
            <group id="1">
                <setting id="host" type="string" label="30201" help="30202">
                    <level>0</level>
                    <default>localhost</default>
                    <constraints><allowempty>true</allowempty></constraints>
                    <control type="edit" format="string"><heading>30201</heading></control>
                </setting>
                <setting id="port" type="integer" label="30203" help="30204">
                    <level>0</level>
                    <default>10002</default>
                    <control type="edit" format="integer"><heading>30203</heading></control>
                </setting>
            </group>
        </category>
        <category id="mix" label="30300">
            <group id="1">
                <setting id="playlist_size" type="integer" label="30301" help="30302">
                    <level>0</level>
                    <default>20</default>
                    <constraints><minimum>1</minimum><step>1</step><maximum>100</maximum></constraints>
                    <control type="slider" format="integer"><popup>false</popup></control>
                </setting>
                <setting id="mix_style_preference" type="integer" label="30303" help="30304">
                    <level>0</level>
                    <default>2</default>
                    <constraints><minimum>0</minimum><step>1</step><maximum>10</maximum></constraints>
                    <control type="slider" format="integer"><popup>false</popup></control>
                </setting>
                <setting id="mix_variety" type="integer" label="30305" help="30306">
                    <level>0</level>
                    <default>0</default>
                    <constraints><minimum>0</minimum><step>1</step><maximum>9</maximum></constraints>
                    <control type="slider" format="integer"><popup>false</popup></control>
                </setting>
                <setting id="mix_filter" type="string" label="30307" help="30308">
                    <level>0</level>
                    <default/>
                    <constraints><allowempty>true</allowempty></constraints>
                    <control type="edit" format="string"><heading>30307</heading></control>
                </setting>
                <setting id="mix_reject_size" type="integer" label="30309" help="30310">
                    <level>0</level>
                    <default>0</default>
                    <constraints><minimum>0</minimum><step>1</step><maximum>20</maximum></constraints>
                    <control type="slider" format="integer"><popup>false</popup></control>
                </setting>
            </group>
        </category>
        <category id="discovery" label="30500">
            <group id="1">
                <setting id="discovery_excerpt_seconds" type="integer" label="30501" help="30502">
                    <level>0</level>
                    <default>20</default>
                    <constraints><minimum>5</minimum><step>1</step><maximum>60</maximum></constraints>
                    <control type="slider" format="integer"><popup>false</popup></control>
                </setting>
                <setting id="discovery_offset_percent" type="integer" label="30503" help="30504">
                    <level>0</level>
                    <default>33</default>
                    <constraints><minimum>0</minimum><step>1</step><maximum>90</maximum></constraints>
                    <control type="slider" format="integer"><popup>false</popup></control>
                </setting>
            </group>
        </category>
        <category id="consistency" label="30600">
