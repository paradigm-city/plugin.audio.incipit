                <setting id="consistency_interval_minutes" type="integer" label="30315" help="30316">
                    <level>0</level>
                    <default>60</default>
                    <control type="edit" format="integer"><heading>30315</heading></control>
                </setting>
                <setting id="service_auto_repair_enabled" type="boolean" label="30317" help="30318">
                    <level>0</level>
                    <default>false</default>
