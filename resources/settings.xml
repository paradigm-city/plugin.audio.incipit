                </setting>
                <setting id="service_extended_logging" type="boolean" label="30605" help="30606">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle"/>
                </setting>
                <setting id="service_auto_repair_enabled" type="boolean" label="30607" help="30608">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle"/>
                </setting>
            </group>
        </category>
    </section>
</settings>
